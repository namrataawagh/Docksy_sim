<launch>

  <let name="urdf_path"
       value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro"/>

  <let name="rviz_phase2_config"
       value="$(find-pkg-share my_robot_bringup)/rviz/sensors_phase2.rviz"/>

  <let name="gazebo_config_path"
       value="$(find-pkg-share my_robot_bringup)/config/gazebo_bridge.yaml"/>

  <let name="rviz_config_path"
       value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"/>

  <!-- Phase 2: use parking_world for LiDAR scan quality validation -->
  <arg name="phase2" default="false"
       description="Set true to launch with parking_world and sensors_phase2 RViz config"/>

  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description"
           value="$(command 'xacro $(var urdf_path)')"/>
    <param name="use_sim_time" value="true"/>
  </node>

  <!-- Default world: parking_world for Phase 2 sensor verification -->
  <arg name="world" default="$(find-pkg-share my_robot_bringup)/worlds/parking_world.sdf"/>

  <set_env name="GAZEBO_MODEL_PATH" value="$(find-pkg-share my_robot_bringup)/models:$(find-pkg-share my_robot_bringup)/worlds:$(env GAZEBO_MODEL_PATH '')"/>
  <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share my_robot_bringup)/models:$(find-pkg-share my_robot_bringup)/worlds:$(env GZ_SIM_RESOURCE_PATH '')"/>

  <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
    <arg name="gz_args" value="$(var world) -r"/>
  </include>

  <node pkg="ros_gz_sim" exec="create"
        args="-topic robot_description"/>

  <node pkg="ros_gz_bridge" exec="parameter_bridge">
      <param name="config_file" value="$(var gazebo_config_path)"/>
  </node>

  <node pkg="tf2_ros" exec="static_transform_publisher" name="lidar_tf_pub"
        args="0 0 0.23 0 0 0 base_link lidar_link" output="screen">
      <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="tf2_ros" exec="static_transform_publisher" name="imu_tf_pub"
        args="0 0 0 0 0 0 base_link imu_link" output="screen">
      <param name="use_sim_time" value="true"/>
  </node>

  <node pkg="rviz2" exec="rviz2" output="screen"
        args="-d $(var rviz_phase2_config)">
    <param name="use_sim_time" value="true"/>
  </node>

</launch>